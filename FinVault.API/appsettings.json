{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FinVaultDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }

  },
  "JwtSettings": {
    "Issuer": "FinVault.API",
    "Audience": "FinVault.Client",
    "SecretKey": "REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "AllowedHosts": "*"
}
